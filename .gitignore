# ===================================
# GESTOR SEGURO - .gitignore
# ===================================

# ⚠️ ARCHIVOS CRÍTICOS - NUNCA SUBIR
# Bóvedas de contraseñas (contienen datos sensibles)
vault.json
*.json.tmp
mi_boveda.json
test.json
velocidad.json

# ===================================
# Python
# ===================================

# Entorno virtual
.venv/
venv/
env/
ENV/
.virtualenv/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

